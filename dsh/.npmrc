# BoBo/dsh 本地 pnpm 配置
# 1) registry：用户全局 npm 配置指向 npmmirror，该镜像下载部分二进制包
#    （@anthropic-ai/claude-agent-sdk、@openai/codex 的 win32 二进制）不稳定。
#    此处将本仓库固定到官方 registry。
# 2) fetch-timeout / fetch-retries：这类包体积大、下载慢（codex 约 59MB），
#    默认超时太短会被 pnpm 中断（error 23）。提高下载超时与重试次数。
registry=https://registry.npmjs.org
fetch-timeout=600000
fetch-retries=6
