{
  "name": "dsh-tauri-brand",
  "type": "module",
  "version": "1.0.0",
  "description": "SmartBoBo 品牌定制插件：侧栏与会话 Hero 的菠萝图标、SmartBoBo AGENT 字标。",
  "author": "Hairyf <wwu710632@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/dsh-tauri-desk/dsh-tauri-plugins#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-tauri-desk/dsh-tauri-plugins.git",
    "directory": "packages/dsh-tauri-brand"
  },
  "bugs": {
    "url": "https://github.com/dsh-tauri-desk/dsh-tauri-plugins/issues"
  },
  "keywords": [
    "dsh",
    "plugin",
    "dsh-plugin",
    "tauri",
    "deepseek-harness",
    "brand"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./client": {
      "types": "./dist/client.d.cts",
      "default": "./dist/client.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "cordis.patch.yml",
    "dist"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "dsh-tauri"
      ],
      "external": [
        "dsh-tauri/client"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc"
  },
  "dependencies": {
    "dsh-tauri": "workspace:*"
  },
  "devDependencies": {
    "dsh-tauri-tsdown": "workspace:*",
    "tsdown": "catalog:cli"
  }
}
