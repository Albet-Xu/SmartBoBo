{
  "name": "dsh-h3",
  "type": "module",
  "version": "0.2.1",
  "description": "H3 route services for the DeepSeek Harness WebServer and Cordis lifecycle",
  "author": "Anthony Fu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/omdsh-dev/dsh-h3#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omdsh-dev/dsh-h3.git"
  },
  "bugs": "https://github.com/omdsh-dev/dsh-h3/issues",
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./genapi": "./dist/genapi.mjs",
    "./utils": "./dist/utils.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts-info": {
    "build": "Build the library for publishing",
    "coverage": "Run the test suite and collect coverage reports",
    "dev": "Rebuild on change during development",
    "knip": "Find unused files, exports and dependencies",
    "lint": "Check for code style issues",
    "prepack": "Build before publishing",
    "release": "Bump version and publish a release",
    "start": "Run the entry file",
    "test": "Run the test suite",
    "typecheck": "Check types",
    "ci": "Run the full continuous integration pipeline",
    "prepare": "Set up git hooks and skills"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.2",
    "@genapi/shared": "^4.1.4",
    "typescript": "^5.8.3 || ^6.0.3"
  },
  "peerDependenciesMeta": {
    "@genapi/shared": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "h3": "^2.0.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@antfu/ni": "^30.6.0",
    "@antfu/skills": "^0.1.0",
    "@antfu/utils": "^9.3.0",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.2",
    "@genapi/core": "^4.1.4",
    "@genapi/pipeline": "^4.1.4",
    "@genapi/presets": "^4.1.4",
    "@genapi/shared": "^4.1.4",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "5.0.2",
    "bumpp": "^12.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-slop": "^0.1.3",
    "eslint-plugin-sonarjs": "^4.2.2",
    "knip": "^6.38.0",
    "nano-staged": "^1.0.2",
    "publint": "^0.3.24",
    "simple-git-hooks": "^2.14.0",
    "skills-npm": "^4.0.0",
    "taze": "^21.2.0",
    "tsdown": "^0.23.0",
    "tsdown-stale-guard": "^0.1.3",
    "tsnapi": "^1.5.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && pnpm run ci && npx nano-staged"
  },
  "nano-staged": {
    "*.{js,ts,tsx,json,css,md,yaml,vue}": "eslint --fix --no-warn-ignored"
  },
  "scripts": {
    "build": "tsdown",
    "coverage": "pnpm run build && pnpm --filter dsh-plugin-playground build && vitest run --coverage",
    "dev": "tsdown --watch",
    "knip": "knip",
    "lint": "eslint --cache",
    "release": "bumpp",
    "start": "tsx src/index.ts",
    "test": "pnpm run build && pnpm --filter dsh-plugin-playground build && vitest",
    "typecheck": "tsc",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run knip && pnpm run test --run"
  }
}